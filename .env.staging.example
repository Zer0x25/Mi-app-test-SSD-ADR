# ==============================================================================
# Variables de Entorno para Staging / Pre-Producción (.env.staging.example)
# ==============================================================================
# Entorno de ejecución en Docker para pruebas de aceptación y QA
NODE_ENV=staging
PORT=3000

# Puerto expuesto en el host (3001 por defecto para no colisionar con producción en 3000)
STAGING_HOST_PORT=3001

# Base de datos SQLite aislada para Staging dentro del contenedor
DATABASE_URL="file:/app/data/medidores-staging.db"

# Seguridad y Autenticación para pruebas de Staging
JWT_SECRET="super_secreto_medidores_staging_qa_testing_987654"
JWT_EXPIRES_IN="8h"

# Logging en modo debug para diagnósticos de QA
LOG_LEVEL="debug"
