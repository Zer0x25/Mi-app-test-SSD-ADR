# ==============================================================================
# Variables de Entorno del Proyecto (.env.example)
# ==============================================================================
# Copia este archivo a .env y asigna los valores correspondientes a tu entorno local.
# REGLA PARA AGENTES: Toda variable debe ser validada con Zod en src/core/config.ts.
# Queda prohibido el acceso directo a process.env en servicios o controladores.
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL / SQLite / etc. según Hito 0)
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_db?schema=public"

# Seguridad y Autenticación (Secretos para JWT o sesiones)
JWT_SECRET="reemplaza_este_secreto_por_uno_seguro_en_produccion"
JWT_EXPIRES_IN="8h"

# Logging y Monitoreo
LOG_LEVEL="debug"
