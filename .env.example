# ==============================================================================
# Variables de Entorno del Proyecto (.env.example) - Sistema Medidores
# ==============================================================================
# Copia este archivo a .env y asigna los valores correspondientes a tu entorno local.
# REGLA PARA AGENTES: Toda variable debe ser validada con Zod en src/core/config.ts.
# Queda prohibido el acceso directo a process.env en servicios o controladores.
# ==============================================================================

# Entorno de ejecución
NODE_ENV=development
PORT=3000

# Base de datos (SQLite local con Prisma según ADR 0001)
DATABASE_URL="file:./prisma/dev.db"

# Seguridad y Autenticación (Secretos para JWT o sesiones)
JWT_SECRET="super_secreto_medidores_desarrollo_local_123456"
JWT_EXPIRES_IN="8h"

# Logging y Monitoreo
LOG_LEVEL="debug"
